APP_NAME="Slip Gaji Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slipgaji
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file

# ============================================
# SIPENA API Configuration
# ============================================
SIPENA_BASE_URL=https://api.sipena.go.id
SIPENA_API_KEY=your_api_key_here
SIPENA_TIMEOUT=30
SIPENA_RETRY_ATTEMPTS=3
SIPENA_RETRY_DELAY=1000
